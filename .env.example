# AbsenInn — environment variables for the Django backend.
# Copy to AbsenInn/.env for local development (loaded automatically) or set them in your host's dashboard.
# NEVER commit .env. The frontend never sees any of these values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True                      # False in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SERVE_FRONTEND=True                    # Django also serves ../frontend at "/" (one origin, no CORS needed)
FRONTEND_URL=http://localhost:8000     # where invited employees land (reset-password page)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500   # only if the frontend is hosted elsewhere

# --- Database: Supabase → Connect → "Session pooler" (or direct) URI. Use the postgres user. ---
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USE_POOLER=False                    # True only with the *transaction* pooler (port 6543)

# --- Supabase (server only) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret     # storage uploads/signed URLs + employee invitations
SUPABASE_JWT_SECRET=                             # only for projects on the legacy HS256 JWT secret; new projects use JWKS automatically
STORAGE_BACKEND=supabase                         # "local" = files in backend/local_storage (dev only)
SUPABASE_STORAGE_BUCKET_SELFIES=attendance-selfies
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=leave-attachments
SIGNED_URL_EXPIRES_SECONDS=300

# --- Reminders (Phase 8) ---
CRON_SECRET=another-long-random-string           # protects POST /api/cron/reminders/
